<!-- Merge into android/app/src/main/AndroidManifest.xml inside <application>. NOT BUILT OR TESTED (no Android project was provided).
     Rules that prevent duplicate launcher shortcuts:
       * REMOVE the <intent-filter> with MAIN + LAUNCHER from MainActivity itself (keep the activity, android:exported="true").
       * Exactly ONE alias below is enabled at install time (Modern = Light/Day). The plugin flips them at runtime.
     android:name of an alias is relative to the manifest namespace (the Java package of MainActivity), not necessarily the applicationId.
     applicationId / package are untouched. -->
<activity-alias android:name=".LauncherModern" android:targetActivity=".MainActivity" android:enabled="true" android:exported="true"
    android:label="@string/app_name" android:icon="@mipmap/ic_launcher_modern" android:roundIcon="@mipmap/ic_launcher_modern_round">
    <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
</activity-alias>
<activity-alias android:name=".LauncherLibrary" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
    android:label="@string/app_name" android:icon="@mipmap/ic_launcher_library" android:roundIcon="@mipmap/ic_launcher_library_round">
    <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
</activity-alias>
<activity-alias android:name=".LauncherSnow" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
    android:label="@string/app_name" android:icon="@mipmap/ic_launcher_snow" android:roundIcon="@mipmap/ic_launcher_snow_round">
    <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
</activity-alias>
<activity-alias android:name=".LauncherNight" android:targetActivity=".MainActivity" android:enabled="false" android:exported="true"
    android:label="@string/app_name" android:icon="@mipmap/ic_launcher_night" android:roundIcon="@mipmap/ic_launcher_night_round">
    <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
</activity-alias>
